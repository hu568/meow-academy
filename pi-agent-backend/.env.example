# ===== 喵学堂 Pi Agent 后端配置 =====

# --- 聊天模型 (pi-ai 支持任意 provider) ---
# DeepSeek (推荐): https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxx

# 其他可选 provider (任选其一即可, 与 pi-ai 的环境变量名一致)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# MOONSHOT_API_KEY=...

# --- Embedding 模型 (RAG 用, 硅基流动 bge-m3 免费) ---
# https://cloud.siliconflow.cn 注册获取
SILICONFLOW_API_KEY=sk-xxxxxxxx
EMBEDDING_MODEL=BAAI/bge-m3

# --- 服务端口 ---
PORT=8787
