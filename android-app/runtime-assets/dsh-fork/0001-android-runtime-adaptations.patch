+    } catch (error) {
+      // Android app sandbox（untrusted_app）不能 open /data、/data/user/0 等 App 数据根之上的
+      // 父目录做 fsync（EACCES/EPERM）。对进程不可达的祖先做 best-effort：停止向上遍历，
+      // 不把整次发布打成失败（单进程常驻部署下不影响发布正确性，仅少一层崩溃持久性证明）。
+      if (!(error instanceof Error && 'code' in error
+        && (error.code === 'EACCES' || error.code === 'EPERM'))) {
+        throw error
+      }
