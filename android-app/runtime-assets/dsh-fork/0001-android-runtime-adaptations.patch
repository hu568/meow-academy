+// Android (meow fork): SELinux denies link(), so the default guarded-create
+// publication probes the target and reports EEXIST to the shared failure
+// mapper instead of hard-linking; on an absent target rename() publishes.
+async function publishCreateNoReplace(tempPath: string, absolutePath: string): Promise<void> {
+  try {
+    await lstat(absolutePath, { bigint: true })
+  } catch (probeError: unknown) {
+    if (!isENOENT(probeError) && !isENOTDIR(probeError)) throw probeError
+    await rename(tempPath, absolutePath)
+    return
+  }
+  const eexist: NodeJS.ErrnoException = new Error(`EEXIST: file exists: ${absolutePath}`)
+  eexist.code = 'EEXIST'
+  throw eexist
+}
