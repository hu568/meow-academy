     level = parent
@@ -282,9 +293,22 @@ export async function publishImmutableAlias(
     try {
       await link(source, target)
     } catch (error) {
-      /* v8 ignore next -- Private same-filesystem directories make EEXIST the only recoverable link race. */
-      if (!(error instanceof Error && 'code' in error && error.code === 'EEXIST')) throw error
-      if (await digestFile(target) !== sha256) {
+      if (!(error instanceof Error && 'code' in error)) throw error
+      if (error.code === 'EACCES' || error.code === 'EPERM') {
+        // Android app sandbox（untrusted_app）禁止 link(2)（SELinux）。别名语义退化为内容相同的独立副本：
+        // COPYFILE_EXCL 保住 no-replace 竞争语义，内容寻址下两个名字可互换（代价 = 少一层空间去重）。
+        try {
+          await copyFile(source, target, constants.COPYFILE_EXCL)
+        } catch (copyError) {
+          if (!(copyError instanceof Error && 'code' in copyError && copyError.code === 'EEXIST')) throw copyError
+          if (await digestFile(target) !== sha256) {
+            throw new AttachmentError('Stored attachment failed integrity verification.', 'ATTACHMENT_CORRUPT')
+          }
+        }
+      } else if (error.code !== 'EEXIST') {
+        throw error
+      } else if (await digestFile(target) !== sha256) {
+        /* v8 ignore next -- Private same-filesystem directories make EEXIST the only recoverable link race. */
         throw new AttachmentError('Stored attachment failed integrity verification.', 'ATTACHMENT_CORRUPT')
       }
     }
@@ -358,15 +382,37 @@ async function publishStagedObject(
     try {
       await link(staged.path, target)
     } catch (error) {
-      /* v8 ignore next -- Private same-filesystem directories make EEXIST the only recoverable link race. */
-      if (!(error instanceof Error && 'code' in error && error.code === 'EEXIST')) throw error
-      if (await digestFile(target) !== staged.sha256) {
+      if (!(error instanceof Error && 'code' in error)) throw error
+      if (error.code === 'EACCES' || error.code === 'EPERM') {
+        // Android app sandbox（untrusted_app）禁止 link(2)（SELinux）。与 fs-local 同款规避：
+        // lstat 探测命中即视为已存在；未命中用 rename() 原子发布（单进程下语义近似 no-replace）。
+        let targetExists = true
+        try {
+          await lstat(target)
+        } catch (statError) {
+          if (!(statError instanceof Error && 'code' in statError && statError.code === 'ENOENT')) throw statError
+          targetExists = false
+        }
+        if (targetExists) {
+          if (await digestFile(target) !== staged.sha256) {
+            throw new AttachmentError('Stored attachment failed integrity verification.', 'ATTACHMENT_CORRUPT')
+          }
+        } else {
+          await rename(staged.path, target)
+        }
+      } else if (error.code !== 'EEXIST') {
+        throw error
+      } else if (await digestFile(target) !== staged.sha256) {
+        /* v8 ignore next -- Private same-filesystem directories make EEXIST the only recoverable link race. */
         throw new AttachmentError('Stored attachment failed integrity verification.', 'ATTACHMENT_CORRUPT')
       }
     }
     // Windows shares the read-only attribute across hard links and refuses to
     // unlink either name once it is set, so discard the staging name first.
-    await unlink(staged.path)
+    // Android 走 rename() 发布时临时名已随 rename 消失，仅容忍 ENOENT。
+    await unlink(staged.path).catch((cleanupError: unknown) => {
+      if (!(cleanupError instanceof Error && 'code' in cleanupError && cleanupError.code === 'ENOENT')) throw cleanupError
+    })
     // The target remains the sole link for a new object; this also restores
     // read-only mode when the deduplication path observes an existing object.
     await chmod(target, 0o400)
