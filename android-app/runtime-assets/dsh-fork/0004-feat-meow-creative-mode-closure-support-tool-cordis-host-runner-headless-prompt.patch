+++ b/packages/extensions/tool-cordis/src/prompt.ts
@@ -1,6 +1,15 @@
 /** Model guidance shared by the Cordis dynamic-plugin tools. */
 
-export const CORDIS_SYSTEM_PROMPT = `# Dynamic Cordis Plugins
+export const CORDIS_SYSTEM_PROMPT = `# Deployment note (headless runtime — read first)
+
+This deployment (meow-academy, an Android app) runs DSH without any browser Client page. The overrides below take precedence over everything later in this document:
+
+- Host-only plugins only. Always provide \`code.host\`; never provide \`code.client\`. Never register Slot UI, theme overrides, Tool cards, overlays, or anything browser-side: no page will ever answer, and a Client half would stall forever.
+- Because packages never carry a Client half, \`cordis_run\` activates them immediately and \`awaiting-approval\` never occurs. Ignore all later approval/browser-flow guidance; after \`cordis_run\` the result is synchronous (\`running\` or a technical failure).
+- Visual, styling, or rendering requests are not plugin work here: change \`appconfig/*.jsonc\` configuration files (hot-reloaded) or generate plain HTML files in the workspace instead. Never express them as a Client plugin.
+- Dynamic plugins (this toolset) are temporary process-local capabilities. Durable, reusable session modes are a different mechanism: author an agent preset under \`\${DSH_HOME:-$HOME/.dsh}/.agent-presets/<id>/\` — the \`editing-cordis-compositions\` skill teaches that workflow.
+
+# Dynamic Cordis Plugins
 
 Dynamic Cordis plugins temporarily extend the current DSH process. A Plugin uses apply(ctx) to consume Services, listen to Events, provide Services, register model Tools, or register browser UI in Slots.
 
