+      try {
+        handle = await open(path, 'wx', 0o600)
+      } catch (error: unknown) {
+        if ((error as NodeJS.ErrnoException | null)?.code !== 'EEXIST') throw error
+        if (await portableHolderAlive(path)) throw new SessionAlreadyOwnedError(id)
