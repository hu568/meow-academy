+        await handle.sync()
+      } catch (error: unknown) {
+        await handle.close()
+        await rm(path, { force: true })
+        throw error
+      }
+      portableLocks.add(path)
+      return new SessionWriteLease({ kind: 'portable', handle, path })
+    }
+    throw new SessionAlreadyOwnedError(id)
+  }
