@@ -0,0 +1,44 @@
+/**
+ * Publish a staged file at a target path without replacing an existing entry.
+ *
+ * POSIX `link(2)` is the upstream primitive: it fails with `EEXIST` when the
+ * target exists, so two processes publishing one path cannot clobber each
+ * other. The Android app sandbox (`untrusted_app`) is denied `link(2)` by
+ * SELinux (`EACCES`), so that denial falls back to an `lstat` probe plus
+ * `rename(2)`: an existing target still reports `EEXIST`, while an absent one is
+ * published atomically. The probe leaves a small TOCTOU window that upstream's
+ * `link()` closes; the meow-academy runtime runs one resident DSH process, so
+ * concurrent publishers of one Session path do not occur there.
+ * @module @deepseek-ai/dsh-session-persistence-jsonl/publish
+ */
+
+import { link, lstat, rename } from 'node:fs/promises'
+
+/**
+ * Publish `existingPath` at `newPath`, refusing to replace an existing target.
+ * @param existingPath - staged file to publish; a rename publish consumes it.
+ * @param newPath - target path, which must not already exist.
+ * @throws {NodeJS.ErrnoException} `EEXIST` when the target already exists, so callers mapping that code keep their collision behavior.
+ */
+export async function publishLinkNoReplace(existingPath: string, newPath: string): Promise<void> {
+  try {
+    await link(existingPath, newPath)
+    return
+  } catch (error) {
+    if (!(error instanceof Error && 'code' in error)) throw error
+    if (error.code !== 'EACCES' && error.code !== 'EPERM') throw error
+  }
+  try {
+    await lstat(newPath)
+  } catch (probeError) {
+    if (!(probeError instanceof Error && 'code' in probeError && probeError.code === 'ENOENT')) throw probeError
+    await rename(existingPath, newPath)
+    return
+  }
+  // The target stands: report the collision exactly as a denied link() would.
+  throw Object.assign(new Error(`EEXIST: file already exists, link '${existingPath}' -> '${newPath}'`), {
+    code: 'EEXIST',
+    errno: -17,
+    syscall: 'link',
+  })
+}
