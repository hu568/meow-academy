// 🐾 喵仓 Markdown 渲染配置
// 使用说明见 appconfig/README.md
// 可修改项：43 · 版本：2026-08-24T12:00:00Z
{
  "version": "2026-08-24T12:00:00Z",
  "_editableCount": 43,

  // ── 公式块（$$…$$） ──────────────────────────────
  "formula": {
    "blockCornerRadiusDp": 12,          // 背景圆角 (dp)，0 = 直角
    "blockBackground": {                // 浅色浅灰 / 深色深灰，null = 无背景（主题感知）
      "light": "#F2F2F7",
      "dark": "#1E1E2E"
    },
    "blockPaddingDp": {                 // 内边距 (dp)
      "left": 16,
      "top": 8,
      "right": 16,
      "bottom": 8
    },
    "blockFitCanvas": true,             // 是否撑满容器宽度
    "blockAlign": 1,                    // 0=左 1=中 2=右
    "blockTextColor": null,             // 公式块文字色，null = 跟随主题（主题感知）
    "inlineTextColor": null             // 行内公式文字色，null = 跟随主题（主题感知）
  },

  // ── 无序列表「-」渲染的 · 大小 ──────────────────────
  "list": {
    "bulletWidthDp": 6,                 // · 的直径 (dp)
    "bulletStrokeWidthDp": 1,           // 描边宽 (dp)
    "itemColor": null                   // 项目颜色，null = 跟随主题（主题感知）
  },

  // ── 代码（``` 围栏块 + 行内 `code`） ───────────────
  "code": {
    "blockCornerRadiusDp": 10,          // 代码块背景圆角 (dp)，0 = 直角
    "blockBackground": null,            // 代码块背景色，null = 主题默认（主题感知）
    "blockMarginDp": 8,                 // 代码块外边距 (dp)
    "blockTextSizeRatio": 0.85,         // 代码块内文字相对正文比例
    "textSizeRatio": 0.85,              // 行内代码相对正文比例
    "blockTextColor": null,             // 代码块文字色，null = 主题默认（主题感知）
    "textColor": null,                  // 行内代码文字色，null = 主题默认（主题感知）
    "inlineCornerRadiusDp": 6,          // 行内代码背景圆角 (dp)，0 = 恢复 Markwon 直角
    "inlineBackground": null,           // 行内代码背景色，null = 主题默认（当前文字色 10% 透明度）（主题感知）
    "inlinePaddingDp": {                // 行内代码内边距 (dp)
      "left": 5,
      "top": 2,
      "right": 5,
      "bottom": 2
    }
  },

  // ── 引用块 ────────────────────────────────────────
  "quote": {
    "color": null,                      // 左侧竖线颜色，null = 主题默认（主题感知）
    "widthDp": 4                        // 左侧竖线宽 (dp)
  },

  // ── 链接 ──────────────────────────────────────────
  "link": {
    "color": null,                      // 链接颜色，null = 主题默认（主题感知）
    "underlined": true                  // 是否下划线
  },

  // ── 标题（H1..H6） ────────────────────────────────
  "heading": {
    "sizeMultipliers": [1.6, 1.4, 1.25, 1.15, 1.1, 1.0] // H1..H6 相对正文倍率
  },

  // ── 水平分割线 ─────────────────────────────────────
  "thematicBreak": {
    "color": null,                      // 分割线颜色，null = 主题默认（主题感知）
    "heightDp": 2                       // 分割线高 (dp)
  },

  // ── 表格 ──────────────────────────────────────────
  "table": {
    "cornerRadiusDp": 12,               // 表格圆角 (dp)
    "headerBackground": {               // 表头背景色，null = 主题默认（主题感知）
      "light": "#E8E8ED",
      "dark": "#2A2A3A"
    },
    "rowAltBackground": null,           // 斑马纹背景，null = 无（主题感知）
    "borderColor": {                    // 边框颜色，null = 主题默认（主题感知）
      "light": "#D1D1D6",
      "dark": "#383850"
    },
    "borderWidthDp": 1,                 // 边框宽 (dp)
    "cellPaddingDp": {                  // 单元格内边距 (dp)
      "left": 10,
      "top": 6,
      "right": 10,
      "bottom": 6
    },
    "copyButtonColor": null             // 复制按钮颜色，null = 主题默认（主题感知）
  },

  // ── Mermaid 图 ────────────────────────────────────
  "mermaid": {
    "theme": "",                        // '' = 自动跟随系统深色，'dark'/'default'/'neutral'/'forest'/'base'
    "cornerRadiusDp": 12,               // 图块背景圆角 (dp)，0 = 直角
    "blockBackground": null             // 图块背景色，null = 主题默认（surfaceVariant 半透明）（主题感知）
  },

  // ── 图片（md 渲染 + 聊天图片） ─────────────────────
  "image": {
    "cornerRadiusDp": 12,               // 图片圆角 (dp)，0 = 直角
    "borderWidthDp": 1,                 // 线框宽 (dp)，0 = 无边框
    "borderColor": {                    // 线框颜色，null = 跟随主题（主题感知）
      "light": "#D1D1D6",
      "dark": "#383850"
    },
    "maxHeightDp": 320,                 // 聊天气泡内图片最大高度 (dp)
    "loadingBackground": null,          // 加载中背景色，null = 主题默认（surfaceVariant 半透明）（主题感知）
    "errorText": "图片加载失败"          // 加载失败提示文案
  }
}
